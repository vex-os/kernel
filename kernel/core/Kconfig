config KPRINTF_BUFSIZE
    int "Kernel log buffer size (bytes)"
    range 2048 1048576
    default 65536
    help
      Ring buffer of recent kernel messages at every level,
      replayed to consoles that register or take their
      device back later; a multiple of 8

comment "Consoles"

source "kernel/fbcons/Kconfig"

config BXCONS
    bool "Bochs debug port console"
    depends on ARCH_HAS_DEBUGCON
    default y
    help
      Print kernel messages to the debug I/O port, which
      QEMU and Bochs can redirect to a file or stdio

comment "Firmware"

config UACPI_QUIET
    bool "Silence uACPI log messages"
    default y
    help
      Drop the messages uACPI logs while it parses
      and runs the firmware ACPI tables
